{%- comment -%}
  Renders a small decorative inline SVG icon.
  Accepts:
  - name: truck | shield | refresh | headset | tag | check | star | heart
{%- endcomment -%}
<svg class="sk-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'truck' -%}
      <path d="M2 6h11v10H2zM13 9h4l3 3v4h-7z"></path><circle cx="6.5" cy="17.5" r="1.8"></circle><circle cx="16.5" cy="17.5" r="1.8"></circle>
    {%- when 'shield' -%}
      <path d="M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6z"></path><path d="M8.5 12l2.5 2.5L15.5 10"></path>
    {%- when 'refresh' -%}
      <path d="M20 11a8 8 0 0 0-14-4L4 9"></path><path d="M4 4v5h5"></path><path d="M4 13a8 8 0 0 0 14 4l2-2"></path><path d="M20 20v-5h-5"></path>
    {%- when 'headset' -%}
      <path d="M4 14v-2a8 8 0 0 1 16 0v2"></path><rect x="3" y="14" width="4" height="6" rx="1.5"></rect><rect x="17" y="14" width="4" height="6" rx="1.5"></rect>
    {%- when 'tag' -%}
      <path d="M3 12V4h8l10 10-8 8z"></path><circle cx="7.5" cy="8.5" r="1.2"></circle>
    {%- when 'star' -%}
      <path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"></path>
    {%- when 'heart' -%}
      <path d="M12 20s-8-4.6-8-10.2A4.3 4.3 0 0 1 12 7a4.3 4.3 0 0 1 8 2.8C20 15.4 12 20 12 20z"></path>
    {%- else -%}
      <path d="M5 12.5l4.5 4.5L19 7.5"></path>
  {%- endcase -%}
</svg>
