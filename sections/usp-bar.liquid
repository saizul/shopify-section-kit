<section
  class="sk-usp"
  style="--sk-usp-bg: {{ section.settings.background }}; --sk-usp-text: {{ section.settings.text_color }};"
  aria-label="{{ 'sections.usp.label' | t }}"
>
  <ul class="sk-usp__list page-width">
    {%- for block in section.blocks -%}
      <li class="sk-usp__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != 'none' -%}
          {% render 'sk-icon', name: block.settings.icon %}
        {%- endif -%}
        <span class="sk-usp__copy">
          {%- if block.settings.title != blank -%}
            <strong class="sk-usp__title">{{ block.settings.title | escape }}</strong>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <span class="sk-usp__text">{{ block.settings.text | escape }}</span>
          {%- endif -%}
        </span>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% stylesheet %}
  .sk-usp { background: var(--sk-usp-bg, #f6f6f6); color: var(--sk-usp-text, #111); }
  .sk-usp__list { list-style: none; margin: 0 auto; padding: 1rem 1.25rem; max-width: 70rem; display: grid; grid-auto-flow: column; grid-auto-columns: 78%; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; }
  .sk-usp__item { display: flex; align-items: center; gap: .75rem; scroll-snap-align: start; }
  .sk-usp__copy { display: flex; flex-direction: column; font-size: .9rem; line-height: 1.3; }
  .sk-usp__title { font-size: .95rem; }
  .sk-icon { flex: none; }
  @media (min-width: 750px) {
    .sk-usp__list { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); overflow: visible; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "USP bar",
  "tag": "section",
  "class": "sk-section",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#f6f6f6" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#111111" }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "none", "label": "None" },
          { "value": "truck", "label": "Delivery" },
          { "value": "shield", "label": "Shield" },
          { "value": "refresh", "label": "Returns" },
          { "value": "headset", "label": "Support" },
          { "value": "tag", "label": "Tag" },
          { "value": "check", "label": "Check" },
          { "value": "star", "label": "Star" },
          { "value": "heart", "label": "Heart" }
        ], "default": "check" },
        { "type": "text", "id": "title", "label": "Title", "default": "Fast delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "2-3 days inside Dhaka" }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP bar",
      "blocks": [
        { "type": "usp", "settings": { "icon": "truck", "title": "Fast delivery", "text": "2-3 days inside Dhaka" } },
        { "type": "usp", "settings": { "icon": "shield", "title": "Cash on delivery", "text": "Pay when you receive" } },
        { "type": "usp", "settings": { "icon": "refresh", "title": "Easy returns", "text": "7-day return policy" } },
        { "type": "usp", "settings": { "icon": "headset", "title": "Real support", "text": "WhatsApp and phone" } }
      ]
    }
  ]
}
{% endschema %}
