{%- liquid
  assign video = section.settings.video
  assign image = section.settings.image
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign overlay = section.settings.overlay | divided_by: 100.0
-%}

<section
  class="sk-hero sk-hero--{{ section.settings.height }} sk-hero--{{ section.settings.align }}"
  style="--sk-hero-overlay: {{ overlay }}; --sk-hero-text: {{ section.settings.text_color }};"
>
  <div class="sk-hero__media">
    {%- if video != blank -%}
      <video
        class="sk-hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        {% if image != blank %}
          poster="{{ image | image_url: width: 1600 }}"
        {% endif %}
        data-sk-hero-video
        aria-hidden="true"
      >
        {%- for source in video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      </video>
      <button
        type="button"
        class="sk-hero__toggle"
        data-sk-hero-toggle
        data-label-pause="{{ 'sections.hero.pause_video' | t }}"
        data-label-play="{{ 'sections.hero.play_video' | t }}"
      >
        {{ 'sections.hero.pause_video' | t }}
      </button>
    {%- elsif image != blank -%}
      {{
        image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          widths: '600, 900, 1200, 1600, 2000',
          sizes: '100vw',
          class: 'sk-hero__image',
          alt: image.alt
      }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'sk-hero__image sk-hero__placeholder' }}
    {%- endif -%}
  </div>

  <div class="sk-hero__content page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="sk-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <{{ heading_tag }} class="sk-hero__heading">{{ section.settings.heading | escape }}</{{ heading_tag }}>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <div class="sk-hero__subheading">{{ section.settings.subheading }}</div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <div class="sk-hero__buttons">
        {%- for block in section.blocks -%}
          {%- if block.settings.label != blank -%}
            <a
              class="sk-btn{% if block.settings.style == 'secondary' %} sk-btn--secondary{% endif %}"
              {% if block.settings.link != blank %}
                href="{{ block.settings.link }}"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label | escape -}}
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .sk-hero { position: relative; display: flex; align-items: flex-end; overflow: hidden; color: var(--sk-hero-text, #fff); background: #111; isolation: isolate; }
  .sk-hero--small { min-height: 320px; }
  .sk-hero--medium { min-height: 480px; }
  .sk-hero--large { min-height: 80vh; }
  .sk-hero__media, .sk-hero__media::after { position: absolute; inset: 0; }
  .sk-hero__media::after { content: ''; background: rgba(0, 0, 0, var(--sk-hero-overlay, 0.35)); }
  .sk-hero__image, .sk-hero__video, .sk-hero__placeholder { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sk-hero__content { position: relative; z-index: 1; width: 100%; padding: 2.5rem 1.25rem; max-width: 70rem; margin: 0 auto; }
  .sk-hero--center { align-items: center; text-align: center; }
  .sk-hero--center .sk-hero__buttons { justify-content: center; }
  .sk-hero__eyebrow { margin: 0 0 .5rem; text-transform: uppercase; letter-spacing: .12em; font-size: .8rem; }
  .sk-hero__heading { margin: 0 0 .75rem; font-size: clamp(1.9rem, 6vw, 3.75rem); line-height: 1.1; }
  .sk-hero__subheading { max-width: 38rem; margin: 0 0 1.5rem; font-size: 1.05rem; }
  .sk-hero--center .sk-hero__subheading { margin-inline: auto; }
  .sk-hero__buttons { display: flex; flex-wrap: wrap; gap: .75rem; }
  .sk-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: .7rem 1.5rem; background: #fff; color: #111; border: 2px solid #fff; border-radius: 4px; font-weight: 600; text-decoration: none; }
  .sk-btn--secondary { background: transparent; color: inherit; }
  .sk-btn:focus-visible, .sk-hero__toggle:focus-visible { outline: 3px solid #ffbf47; outline-offset: 2px; }
  .sk-hero__toggle { position: absolute; z-index: 2; top: .75rem; right: .75rem; min-height: 44px; padding: .4rem .9rem; background: rgba(0, 0, 0, .6); color: #fff; border: 1px solid rgba(255, 255, 255, .6); border-radius: 4px; cursor: pointer; }
  @media (prefers-reduced-motion: reduce) { .sk-hero__video { display: none; } }
{% endstylesheet %}

{% javascript %}
  (function () {
    var video = document.querySelector('[data-sk-hero-video]');
    var toggle = document.querySelector('[data-sk-hero-toggle]');
    if (!video || !toggle) return;

    function setLabel() {
      toggle.textContent = video.paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause;
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.pause();
    }
    toggle.addEventListener('click', function () {
      if (video.paused) video.play(); else video.pause();
      setLabel();
    });
    setLabel();
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Hero (video / image)",
  "tag": "section",
  "class": "sk-section",
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "video", "id": "video", "label": "Background video", "info": "Shopify-hosted video. Plays muted and loops; paused automatically for visitors who prefer reduced motion." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Used as the video poster, or as the background when no video is set." },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the new season" },
    { "type": "select", "id": "heading_tag", "label": "Heading level", "options": [
      { "value": "h1", "label": "H1 (use once per page)" },
      { "value": "h2", "label": "H2" }
    ], "default": "h2" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>Free delivery across Bangladesh on orders over a threshold you choose.</p>" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "height", "label": "Height", "options": [
      { "value": "small", "label": "Small" },
      { "value": "medium", "label": "Medium" },
      { "value": "large", "label": "Large (80% of screen)" }
    ], "default": "medium" },
    { "type": "select", "id": "align", "label": "Text alignment", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" }
    ], "default": "left" },
    { "type": "range", "id": "overlay", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "style", "label": "Style", "options": [
          { "value": "primary", "label": "Primary" },
          { "value": "secondary", "label": "Secondary (outline)" }
        ], "default": "primary" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero (video / image)",
      "blocks": [
        { "type": "button", "settings": { "label": "Shop now", "style": "primary" } },
        { "type": "button", "settings": { "label": "Learn more", "style": "secondary" } }
      ]
    }
  ]
}
{% endschema %}
