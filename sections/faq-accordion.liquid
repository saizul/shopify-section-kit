{%- liquid
  assign group_name = 'sk-faq-' | append: section.id
  assign exclusive = section.settings.single_open
-%}

<section class="sk-faq page-width" style="--sk-faq-accent: {{ section.settings.accent }};">
  {%- if section.settings.heading != blank -%}
    <h2 class="sk-faq__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  <div class="sk-faq__list">
    {%- for block in section.blocks -%}
      {%- if block.settings.question != blank -%}
        <details
          class="sk-faq__item"
          {% if exclusive %}
            name="{{ group_name }}"
          {% endif %}
          {% if forloop.first and section.settings.open_first %}
            open
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="sk-faq__question">{{ block.settings.question | escape }}</summary>
          <div class="sk-faq__answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{%- comment -%} FAQPage structured data: only printed when the merchant enables it. {%- endcomment -%}
{%- if section.settings.enable_schema and section.blocks.size > 0 -%}
  {%- assign sk_faq_started = false -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank and block.settings.answer != blank -%}
            {%- if sk_faq_started %},{% endif -%}
            {
              "@type": "Question",
              "name": {{ block.settings.question | strip_html | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ block.settings.answer | json }}
              }
            }
            {%- assign sk_faq_started = true -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .sk-faq { max-width: 50rem; margin: 0 auto; padding: 2rem 1.25rem; }
  .sk-faq__heading { margin: 0 0 1rem; font-size: 1.6rem; }
  .sk-faq__item { border-bottom: 1px solid rgba(0, 0, 0, .15); }
  .sk-faq__question { display: flex; justify-content: space-between; align-items: center; gap: 1rem; min-height: 48px; padding: .9rem 0; font-weight: 600; cursor: pointer; list-style: none; }
  .sk-faq__question::-webkit-details-marker { display: none; }
  .sk-faq__question::after { content: '+'; flex: none; font-size: 1.4rem; line-height: 1; color: var(--sk-faq-accent, #111); transition: transform .2s ease; }
  .sk-faq__item[open] > .sk-faq__question::after { content: '\2212'; }
  .sk-faq__question:focus-visible { outline: 3px solid var(--sk-faq-accent, #111); outline-offset: 2px; }
  .sk-faq__answer { padding: 0 0 1rem; line-height: 1.6; }
  .sk-faq__answer > :first-child { margin-top: 0; }
  @media (prefers-reduced-motion: reduce) { .sk-faq__question::after { transition: none; } }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ accordion",
  "tag": "section",
  "class": "sk-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": false },
    { "type": "checkbox", "id": "single_open", "label": "Only one question open at a time", "default": false },
    { "type": "color", "id": "accent", "label": "Accent color", "default": "#111111" },
    { "type": "header", "content": "SEO" },
    { "type": "checkbox", "id": "enable_schema", "label": "Output FAQPage JSON-LD", "default": false, "info": "Only enable when the questions are visible on this page and not duplicated by another FAQ markup on the same page." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does delivery take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Inside Dhaka 2-3 working days, outside Dhaka 3-5 working days.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ accordion",
      "blocks": [
        { "type": "question" },
        { "type": "question", "settings": { "question": "Do you offer cash on delivery?", "answer": "<p>Yes. COD is available in most areas.</p>" } },
        { "type": "question", "settings": { "question": "Can I return a product?", "answer": "<p>Yes, within 7 days if it is unused and in its original packaging.</p>" } }
      ]
    }
  ]
}
{% endschema %}
